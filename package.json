{
  "name": "aether-agents",
  "version": "0.3.2",
  "description": "Open-source terminal coding agent for hosted models or local Ollama, with repository-aware tools, operator-controlled execution, and verified results.",
  "type": "module",
  "bin": {
    "aether": "dist/src/main.js",
    "aether-agent": "dist/src/main.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "README.md",
    "assets/aether-agent-hero.png",
    "COMMANDS.md",
    "docs/generated/commands.md",
    "docs/generated/model-catalogue.md",
    "docs/model-catalogue/catalogue.json",
    "docs/model-catalogue/index.html",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/copy-skill-assets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "dev": "npm run build && node dist/src/main.js",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test --test-isolation=none \"dist/test/**/*.test.js\"",
    "smoke": "npm run build && node -e \"import('./dist/src/core/smoke.js').then(m=>m.smokeMain()).then(c=>process.exit(c)).catch(e=>{console.error(e);process.exit(1)})\"",
    "verify:production": "npm run build && node dist/scripts/verify-production.js",
    "release:truth": "npm run build && node dist/scripts/release-truth.js",
    "docs:generate": "npm run build && node dist/scripts/generate-docs.js",
    "docs:check": "npm run build && node dist/scripts/generate-docs.js --check",
    "release:candidate": "npm run build && node dist/scripts/release-candidate.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "demo:handoff": "npm run build && node dist/scripts/handoff-demo.js"
  },
  "keywords": [
    "coding-agent",
    "ai-coding-assistant",
    "developer-tools",
    "terminal-agent",
    "local-first",
    "local-llm",
    "ollama",
    "mcp",
    "typescript",
    "code-review",
    "software-engineering",
    "open-source"
  ],
  "license": "Apache-2.0",
  "author": "Brandon Barrante (Aether AI)",
  "homepage": "https://aethersystems.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/AetherAI3/aether-agent"
  },
  "bugs": {
    "url": "https://github.com/AetherAI3/aether-agent/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
