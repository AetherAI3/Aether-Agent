{
  "type": "Strategy",
  "nanoIrVersion": "0.1.0",
  "name": "CredentialAgeAlert",
  "effects": ["intent.emit", "log.append"],
  "nodes": [
    { "type": "Schedule", "interval": "1d" },
    { "type": "Condition", "signal": "CREDENTIAL_AGE_DAYS", "operator": ">=", "value": 80 },
    { "type": "Intent", "action": "OBSERVE" },
    { "type": "Agent", "name": "SecurityDesk" }
  ]
}
