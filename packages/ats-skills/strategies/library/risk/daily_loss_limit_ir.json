{
  "type": "Strategy",
  "nanoIrVersion": "0.1.0",
  "name": "DailyLossLimit",
  "effects": ["intent.emit", "log.append"],
  "nodes": [
    { "type": "Schedule", "interval": "1m" },
    { "type": "Condition", "signal": "DAY_LOSS_PCT", "operator": ">=", "value": 2 },
    { "type": "Intent", "action": "PAUSE" },
    { "type": "Agent", "name": "RiskDesk" }
  ]
}
